# Anthropic API Key for server-side Claude model execution
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override default model (defaults to claude-3-5-haiku-20241022)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Optional: Set to "true" for offline mock streaming during local development / testing without API key
# USE_MOCK_LLM=true
