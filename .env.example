# Google Gemini API Key for server-side Gemini model execution
# You can obtain a free key at https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Alternative variable name also recognized:
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override default model (defaults to gemini-2.0-flash)
# Options: gemini-2.0-flash | gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Optional: Set to "true" for offline mock streaming during local development / testing without API key
# USE_MOCK_LLM=true
